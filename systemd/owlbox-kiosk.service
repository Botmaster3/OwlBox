[Unit]
Description=OwlBox kiosk display (Chromium fullscreen on the 3.5" SPI display, touch disabled)
After=graphical-session.target owlbox.service
PartOf=graphical-session.target

[Service]
ExecStart=/opt/owlbox/scripts/kiosk.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
