[Unit]
Description=OwlBox kiosk display (minimal X + Chromium fullscreen, no desktop environment)
# Takes tty1 over directly instead of a login prompt - there is deliberately
# no display manager/desktop session on this ("Legacy Lite") base image.
Conflicts=getty@tty1.service
# No owlbox-fbcp dependency here anymore: the official 7" DSI Touch Display
# is a native KMS output (auto-detected by the firmware over the DSI ribbon
# cable), not something a separate process has to mirror a framebuffer onto -
# that whole ordering concern was specific to the old 3.5" SPI display.
After=owlbox.service systemd-user-sessions.service getty@tty1.service plymouth-quit.service
Wants=owlbox.service

[Service]
User=owlbox
Group=owlbox
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Type=simple
# No ~/.xinitrc involved: the client to run is passed to startx explicitly.
ExecStart=/usr/bin/startx /opt/owlbox/scripts/kiosk.sh -- :0 vt1 -nolisten tcp
Restart=always
RestartSec=2
# Deprioritize X/Chromium (and everything it forks - renderer/GPU process
# etc.) relative to owlbox.service, which is where mpv actually lives.
# Confirmed on real hardware as THE actual remaining cause of a "continuous
# crackling during playback" complaint that persisted even after removing
# every extra subprocess spawn from the app's own hot paths (see
# owlbox/engine.py's get_state() comment) and after the config.txt/kernel-
# overlay fixes: a bare config.txt edit plus a terminal aplay/mpv test
# (no kiosk, no Chromium running at all) played back perfectly clean on
# the very same hardware, while the full stack with the kiosk's fully
# software-rendered Chromium (see docs/hardware.md - no GPU-accelerated
# path available to it) running alongside kept crackling. Both processes
# had equal (default, Nice=0) scheduling priority, so under the Pi 3B+'s
# limited CPU, Chromium's unaccelerated rendering could - and did - starve
# mpv's audio thread of scheduling slots often enough to be audible, even
# with the app's own generous --audio-buffer=1.0 already in place. A
# positive nice value needs no special privilege for any user (only
# *lowering* niceness/raising priority above default does) - this alone,
# without touching owlbox.service, shifts the CPU scheduler's preference
# in mpv's favour whenever both are competing for the same cycles.
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# X/Chromium can end up in a state that ignores SIGTERM outright (confirmed
# on real hardware: systemd's default 90s TimeoutStopSec ran out and had to
# SIGKILL) - shortened so a stuck kiosk gets force-killed and restarted
# quickly instead of leaving the display dead for a minute and a half.
TimeoutStopSec=15
StandardInput=tty
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
